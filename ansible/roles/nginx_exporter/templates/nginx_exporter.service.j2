# ~/project1-aws/ansible/roles/nginx_exporter/templates/nginx_exporter.service.j2
[Unit]
Description=NGINX Prometheus Exporter
After=network.target

[Service]
User=nginx_exporter
Group=nginx_exporter
Type=simple
# nginx stub_status 엔드포인트 주소 (nginx.conf에서 stub_status 활성화 필요)
ExecStart=/usr/local/bin/nginx_exporter \
  --nginx.scrape-uri=http://{{ nginx_status_host | default('127.0.0.1') }}:{{ nginx_status_port | default('80') }}/stub_status \
  --web.listen-address=:{{ nginx_exporter_port | default('9113') }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target